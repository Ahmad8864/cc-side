{
  "name": "cc-side",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "test": "bun test",
    "typecheck": "tsc -p .",
    "validate": "./scripts/claude.sh plugin validate .claude-plugin/plugin.json",
