{
  "name": "cc-side",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "test": "bun test",
    "typecheck": "tsc -p .",
    "types:check": "bun scripts/check-mod-types.ts",
    "types:update": "bun scripts/update-mod-types.ts",
    "validate": "claude plugin validate .claude-plugin/plugin.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run types:check && bun run typecheck && bun test",
    "build": "bun scripts/build.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ahmad8864/cc-side.git"
  }
}
